generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  email
  google
}

enum UserPlanTier {
  free
  project_bundle
}

enum ChatSessionStatus {
  draft
  running
  completed
  failed
}

enum AgentRunStatus {
  queued
  running
  completed
  failed
}

enum RazorpayOrderStatus {
  created
  paid
  failed
}

model User {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  email              String       @unique
  passwordHash       String?
  name               String?
  provider           AuthProvider @default(email)
  googleId           String?
  avatarUrl          String?
  role               String       @default("user")
  onboardingDone     Boolean      @default(false)
  onboardingUserType String?
  onboardingSource   String?
  onboardingGoal     String?
  onboardingStage    String?
  planTier           UserPlanTier @default(free)
  projectCredits     Int          @default(0)
  refreshTokenHash   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  chatSessions       ChatSession[]
  razorpayOrders     RazorpayOrder[]
  passwordResetOtps   PasswordResetOtp[]
}

model ChatSession {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  userId     String            @db.ObjectId
  rawIdea    String?
  title      String
  idea       String
  projectCategory String?
  recommendedFirstAgent String?
  isPublic   Boolean           @default(false)
  publicShareToken String?
  memoryJson Json?
  status     ChatSessionStatus @default(draft)
  progress   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  agentRuns  AgentRun[]
  aiCallUsages AiCallUsage[]
  tavilyUsages TavilyUsage[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([publicShareToken])
}

model AgentRun {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  chatSessionId String         @db.ObjectId
  agentType     String
  status        AgentRunStatus @default(queued)
  startedAt     DateTime?
  finishedAt    DateTime?
  resultJson    Json?
  errorMessage  String?
  reportPath    String?
  reportName    String?
  isPublic      Boolean        @default(false)
  publicShareToken String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  chatSession   ChatSession    @relation(fields: [chatSessionId], references: [id])
  aiCallUsages  AiCallUsage[]
  tavilyUsages  TavilyUsage[]

  @@index([chatSessionId, createdAt])
  @@index([status])
  @@index([publicShareToken])
}

model AiCallUsage {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  chatSessionId      String?      @db.ObjectId
  agentRunId         String?      @db.ObjectId
  agentType          String?
  callLabel          String?
  provider           String
  requestedModelName String?
  finalModelName     String
  status             String
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  advancedParams     Json?
  rawUsage           Json?
  latencyMs          Int?
  errorMessage       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  chatSession        ChatSession? @relation(fields: [chatSessionId], references: [id])
  agentRun           AgentRun?    @relation(fields: [agentRunId], references: [id])

  @@index([chatSessionId, createdAt])
  @@index([agentRunId, createdAt])
  @@index([agentType])
  @@index([provider])
  @@index([status])
}

model TavilyUsage {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  chatSessionId     String?      @db.ObjectId
  agentRunId        String?      @db.ObjectId
  agentType         String?
  callLabel         String?
  query             String
  searchDepth       String
  topic             String?
  maxResults        Int?
  includeAnswer     Boolean?
  includeRawContent Boolean?
  includeImages     Boolean?
  creditsUsed       Int
  resultCount       Int?
  status            String
  latencyMs         Int?
  errorMessage      String?
  rawUsage          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  chatSession       ChatSession? @relation(fields: [chatSessionId], references: [id])
  agentRun          AgentRun?    @relation(fields: [agentRunId], references: [id])

  @@index([chatSessionId, createdAt])
  @@index([agentRunId, createdAt])
  @@index([agentType])
  @@index([status])
}

model AiModelAudit {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  prompt             String
  requestedModelName String
  finalProvider      String
  finalModelName     String
  status             String
  usedFallback       Boolean   @default(false)
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  advancedParams     Json?
  rawUsage           Json?
  attempts           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([requestedModelName])
  @@index([finalProvider])
  @@index([status])
  @@index([createdAt])
}

model BugReport {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?  @db.ObjectId
  message     String
  attachmentUrl String?
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model RazorpayOrder {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  userId        String               @db.ObjectId
  planCode      String
  planName      String
  amountInr     Int
  amountPaise   Int
  projects      Int
  receipt       String               @unique
  orderId       String               @unique
  paymentId     String?              @unique
  signature     String?
  status        RazorpayOrderStatus  @default(created)
  paidAt        DateTime?
  errorMessage  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user          User                 @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

model PasswordResetOtp {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  email       String
  otpHash     String
  attempts    Int      @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([expiresAt])
}
