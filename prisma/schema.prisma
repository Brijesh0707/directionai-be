generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  email
  google
}

enum ChatSessionStatus {
  draft
  running
  completed
  failed
}

enum AgentRunStatus {
  queued
  running
  completed
  failed
}

model User {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  email              String       @unique
  passwordHash       String?
  name               String?
  provider           AuthProvider @default(email)
  googleId           String?
  avatarUrl          String?
  role               String       @default("user")
  onboardingDone     Boolean      @default(false)
  onboardingUserType String?
  onboardingSource   String?
  onboardingGoal     String?
  onboardingStage    String?
  refreshTokenHash   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  chatSessions       ChatSession[]
}

model ChatSession {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  userId     String            @db.ObjectId
  title      String
  idea       String
  status     ChatSessionStatus @default(draft)
  progress   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  agentRuns  AgentRun[]
  aiCallUsages AiCallUsage[]
  tavilyUsages TavilyUsage[]

  @@index([userId, createdAt])
  @@index([status])
}

model AgentRun {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  chatSessionId String         @db.ObjectId
  agentType     String
  status        AgentRunStatus @default(queued)
  startedAt     DateTime?
  finishedAt    DateTime?
  resultJson    Json?
  errorMessage  String?
  reportPath    String?
  reportName    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  chatSession   ChatSession    @relation(fields: [chatSessionId], references: [id])
  aiCallUsages  AiCallUsage[]
  tavilyUsages  TavilyUsage[]

  @@index([chatSessionId, createdAt])
  @@index([status])
}

model AiCallUsage {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  chatSessionId      String?      @db.ObjectId
  agentRunId         String?      @db.ObjectId
  agentType          String?
  callLabel          String?
  provider           String
  requestedModelName String?
  finalModelName     String
  status             String
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  advancedParams     Json?
  rawUsage           Json?
  latencyMs          Int?
  errorMessage       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  chatSession        ChatSession? @relation(fields: [chatSessionId], references: [id])
  agentRun           AgentRun?    @relation(fields: [agentRunId], references: [id])

  @@index([chatSessionId, createdAt])
  @@index([agentRunId, createdAt])
  @@index([agentType])
  @@index([provider])
  @@index([status])
}

model TavilyUsage {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  chatSessionId     String?      @db.ObjectId
  agentRunId        String?      @db.ObjectId
  agentType         String?
  callLabel         String?
  query             String
  searchDepth       String
  topic             String?
  maxResults        Int?
  includeAnswer     Boolean?
  includeRawContent Boolean?
  includeImages     Boolean?
  creditsUsed       Int
  resultCount       Int?
  status            String
  latencyMs         Int?
  errorMessage      String?
  rawUsage          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  chatSession       ChatSession? @relation(fields: [chatSessionId], references: [id])
  agentRun          AgentRun?    @relation(fields: [agentRunId], references: [id])

  @@index([chatSessionId, createdAt])
  @@index([agentRunId, createdAt])
  @@index([agentType])
  @@index([status])
}

model AiModelAudit {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  prompt             String
  requestedModelName String
  finalProvider      String
  finalModelName     String
  status             String
  usedFallback       Boolean   @default(false)
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  advancedParams     Json?
  rawUsage           Json?
  attempts           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([requestedModelName])
  @@index([finalProvider])
  @@index([status])
  @@index([createdAt])
}
